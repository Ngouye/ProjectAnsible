# {{ ansible_managed }}
# Les comptes admin s'authentifient uniquement par clé SSH (mots de passe verrouillés),
# d'où NOPASSWD. Chaque commande est journalisée (voir le rôle hardening).
{% for user in common_admin_users if user.state | default('present') == 'present' %}
{{ user.name }} ALL=(ALL:ALL) NOPASSWD: ALL
{% endfor %}
