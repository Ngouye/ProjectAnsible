// {{ ansible_managed }}
// Overrides 50unattended-upgrades: security origins only (Ubuntu default list).
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Automatic-Reboot "{{ hardening_auto_reboot | bool | lower }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ hardening_auto_reboot_time }}";
Unattended-Upgrade::SyslogEnable "true";
