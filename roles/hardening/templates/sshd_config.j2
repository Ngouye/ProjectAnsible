# {{ ansible_managed }}
#
# Configuration durcie du serveur OpenSSH (inspirée du CIS).
# Les fichiers de /etc/ssh/sshd_config.d/ ne sont volontairement PAS inclus :
# cloud-init ou une mise à jour de paquet ne peut pas réactiver discrètement les mots de passe.

Port {{ hardening_ssh_port }}
AddressFamily any

HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_rsa_key

# --- Cryptographie : algorithmes modernes uniquement -------------------------------
KexAlgorithms {{ hardening_ssh_kex_algorithms | join(',') }}
Ciphers {{ hardening_ssh_ciphers | join(',') }}
MACs {{ hardening_ssh_macs | join(',') }}

# --- Authentification : clé publique uniquement, jamais root ------------------------
PermitRootLogin no
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
HostbasedAuthentication no
IgnoreRhosts yes
StrictModes yes
UsePAM yes
AllowGroups {{ hardening_ssh_allowed_groups | join(' ') }}

MaxAuthTries {{ hardening_ssh_max_auth_tries }}
MaxSessions {{ hardening_ssh_max_sessions }}
MaxStartups 10:30:60
LoginGraceTime {{ hardening_ssh_login_grace_time }}

# --- Sessions : aucune redirection, délai d'inactivité -------------------------------
ClientAliveInterval {{ hardening_ssh_client_alive_interval }}
ClientAliveCountMax {{ hardening_ssh_client_alive_count_max }}
TCPKeepAlive no
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
Compression no
UseDNS no

# --- Journalisation et bannière ------------------------------------------------------
SyslogFacility AUTH
LogLevel VERBOSE
PrintMotd no
PrintLastLog yes
Banner /etc/issue.net

Subsystem sftp internal-sftp
