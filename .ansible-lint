---
# Profil ansible-lint le plus strict : ce qui est attendu d'un code destiné à la production
profile: production

exclude_paths:
  - .cache/
  - .github/
  - collections/
  - reports/

# Le fichier d'inventaire amazon.aws n'est pas un playbook
kinds:
  - inventory: "inventories/*/aws_ec2.yml"

use_default_rules: true
offline: false
